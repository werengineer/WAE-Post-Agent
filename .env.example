# Your automation endpoint must accept the JSON payload documented in README.md.
SOCIAL_WEBHOOK_URL=https://your-automation-service.example/webhook/social
SOCIAL_WEBHOOK_TOKEN=your-webhook-secret

# Shared model for the combined agent, lead extraction, and social drafting.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
AGENT_TIMEZONE=Asia/Kolkata

# WhatsApp transport: "openwa" (unofficial gateway, the default) or "cloud" (Meta's official WhatsApp Cloud API).
WHATSAPP_PROVIDER=openwa
# --- only for WHATSAPP_PROVIDER=cloud (see "Official WhatsApp (Cloud API)" in README.md) ---
WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-system-user-permanent-token
WHATSAPP_APP_SECRET=your-meta-app-secret
# Any long random text (16+ characters): Meta sends it back once when you register the webhook URL.
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-text
# Optional: approved template with ONE body variable, used for owner notifications outside the 24-hour window.
CLOUD_OWNER_TEMPLATE=
CLOUD_OWNER_TEMPLATE_LANG=en

# Reply to every lead automatically, without a person approving each draft: "on" or "off" (default off: replies stay drafts).
# Individual chats only, and capped: per customer per hour and per day. Over a cap the reply stays a draft for a person.
AUTO_REPLY=off
AUTO_REPLY_MAX_PER_CHAT_HOUR=6
AUTO_REPLY_MAX_PER_DAY=1000

# Automatic follow-up (OpenWA mode only): a customer who got our reply and went quiet gets a polite nudge. "on" or "off" (default off).
# FOLLOWUP_DELAYS_HOURS: hours after our reply for the first follow-up ("24,72" adds a second one 72 hours after the first).
# A new message from the customer cancels the waiting follow-up; "stop" / "not interested" / "nahi chahiye" blocks that chat for good.
# Only inside FOLLOWUP_HOURS (local time of AGENT_TIMEZONE), at most FOLLOWUP_MAX_PER_DAY a day, individual chats only.
FOLLOWUP=off
FOLLOWUP_DELAYS_HOURS=24
FOLLOWUP_HOURS=10-19
FOLLOWUP_MAX_PER_DAY=200

# WhatsApp gateway and test-chat boundary. (The chat ids below are digits@c.us for both transports.)
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=your-openwa-api-key
OPENWA_SESSION_ID=your-linked-session-id
# Only this exact chat is processed. Blank/missing blocks all customer chats.
OPENWA_TEST_CHAT_ID=919876543210@c.us
# true = answer every person who writes to the number (individual chats only: the linked phone is usually in many groups).
OPENWA_ALLOW_ALL_CHATS=false
# Only with OPENWA_ALLOW_ALL_CHATS=true: also read group chats. Leave false unless you really want group replies (they go to the whole group).
OPENWA_ALLOW_GROUPS=false
# Private owner notification chat; use a separate number you control.
OPENWA_OWNER_CHAT_ID=919876543210@c.us
OPENWA_WEBHOOK_SECRET=replace-with-a-long-random-secret
WHATSAPP_DB=whatsapp.sqlite3
# Separate UI API bearer token (not the OpenWA API key). Blank disables the UI API.
WHATSAPP_API_TOKEN=replace-with-a-random-private-token
# Exact browser UI origins, comma-separated. No wildcard and no trailing slash.
WHATSAPP_API_ORIGINS=http://localhost:3000,http://localhost:5173

# Native publishing (python -m app publish-direct). Fill in locally; never commit real values.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:organization:0
X_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
